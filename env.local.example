# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Supabase Dashboard -> Project Settings -> API.
#
# IMPORTANT: only the URL and the anon/publishable key belong here.
# NEVER put the service_role key or database password in this file or
# anywhere prefixed with NEXT_PUBLIC_ — that would expose it to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
